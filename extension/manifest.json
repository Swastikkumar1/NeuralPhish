{
  "manifest_version": 3,
  "name": "NeuralPhish - Messenger & URL Shield",
  "version": "2.1.0",
  "description": "Real-time AI phishing protection for WhatsApp Web, Gmail, Outlook, and web browsing.",
  "permissions": [
    "contextMenus",
    "notifications",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NeuralPhish Messenger Shield"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
